{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https:; upgrade-insecure-requests; script-src 'self' https://pay.flitt.com https://pay.google.com https://applepay.cdn-apple.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://pay.flitt.com; font-src 'self' data: https://fonts.gstatic.com https://pay.flitt.com https://applepay.cdn-apple.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://*.mux.com; connect-src 'self' https://vhuagxhfmhzyfazbhwpx.supabase.co wss://vhuagxhfmhzyfazbhwpx.supabase.co https://*.flitt.com https://pay.google.com https://google.com https://*.google.com https://*.apple.com https://*.mux.com https://*.litix.io https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https:; worker-src 'self' blob:; manifest-src 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lesiko.vercel.app"
        }
      ],
      "destination": "https://www.lesiko.ge/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "https://vhuagxhfmhzyfazbhwpx.supabase.co/functions/v1/seo/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://vhuagxhfmhzyfazbhwpx.supabase.co/functions/v1/seo/sitemap.xml"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|WhatsApp|TelegramBot|LinkedInBot|Discordbot|Pinterest|bingbot|Googlebot|Baiduspider|DuckDuckBot|Applebot).*"
        }
      ],
      "destination": "https://vhuagxhfmhzyfazbhwpx.supabase.co/functions/v1/seo/render?path=/"
    },
    {
      "source": "/:path((?!assets/).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|WhatsApp|TelegramBot|LinkedInBot|Discordbot|Pinterest|bingbot|Googlebot|Baiduspider|DuckDuckBot|Applebot).*"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "x-prerender-bypass"
        }
      ],
      "destination": "https://vhuagxhfmhzyfazbhwpx.supabase.co/functions/v1/seo/render?path=/:path"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
