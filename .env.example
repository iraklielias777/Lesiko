# Supabase — safe to expose to the browser (row level security is what protects
# the data; see supabase/migrations/0002_row_level_security.sql).
# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API.
# On Vercel: Project Settings → Environment Variables (same two names).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Flitt — Edge Function secrets ONLY (never VITE_*, never commit real values).
# Set via: supabase secrets set --project-ref <ref> KEY=value
# Or Supabase Dashboard → Edge Functions → Secrets.
#
# FLITT_MERCHANT_ID   Numeric merchant id from the Flitt merchant portal
# FLITT_SECRET_KEY    Payment key used to SHA1-sign create-token + callbacks
# SITE_URL            MUST match the production storefront origin exactly
#                     (scheme + host, no trailing slash), e.g. https://lesiko.ge
#                     Used for Flitt response_url. Falls back to Admin → SEO
#                     store_settings.siteUrl when unset — set both to the same value.
# ---------------------------------------------------------------------------
# FLITT_MERCHANT_ID=
# FLITT_SECRET_KEY=
# SITE_URL=https://your-production-domain.tld
