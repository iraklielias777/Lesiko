# Supabase — safe to expose to the browser (row level security is what protects
# the data; see supabase/migrations/0002_row_level_security.sql).
# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API.
# On Vercel → Settings → Environment Variables, add ONLY these two (Production).
# Never put Flitt Merchant ID / Payment key / Credit private key on Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Flitt — Supabase Edge Function secrets ONLY (never VITE_*, never Vercel,
# never commit real values). Browser checkout never sees these.
# Set via: supabase secrets set --project-ref <ref> KEY=value
# Or Supabase Dashboard → Edge Functions → Secrets.
#
# FLITT_MERCHANT_ID   Numeric merchant id from the Flitt merchant portal
# FLITT_SECRET_KEY    Payment key used to SHA1-sign create-token + callbacks
# SITE_URL            Optional fallback only. The seo and payments functions read
#                     the store address from Admin → SEO (store_settings.siteUrl)
#                     first; this is used only when that is blank. If set, it must
#                     be the production origin exactly: https://www.lesiko.ge
# ---------------------------------------------------------------------------
# FLITT_MERCHANT_ID=
# FLITT_SECRET_KEY=
# SITE_URL=https://your-production-domain.tld
#
# ---------------------------------------------------------------------------
# QuickShipper — Edge Function secrets ONLY (never VITE_*, never Vercel).
# Ask QS to enable Delivery API on the merchant and allowlist Supabase egress
# IPs. Pickup street/coords live in Admin → Settings, not here.
#
# QS_AUTH_URL         https://test-auth.quickshipper.ge  (prod: https://auth.quickshipper.app)
# QS_API_URL          https://delivery-test.quickshipper.ge  (prod: https://delivery.quickshipper.app)
# QS_CLIENT_ID        DeliveryApiClient for sandbox; production value from QS
# QS_CLIENT_SECRET    DeliveryApiSecret for sandbox; production value from QS
# QS_USERNAME         merchant login
# QS_PASSWORD         merchant password
# QS_WEBHOOK_SECRET   random path token; webhook URL is /delivery/webhook/{secret}
# GOOGLE_GEOCODING_KEY  optional; typed addresses fall back to Nominatim without it
# ---------------------------------------------------------------------------
# QS_AUTH_URL=
# QS_API_URL=
# QS_CLIENT_ID=
# QS_CLIENT_SECRET=
# QS_USERNAME=
# QS_PASSWORD=
# QS_WEBHOOK_SECRET=
# GOOGLE_GEOCODING_KEY=
